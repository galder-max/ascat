                      !is.na(chrNonHomoProbesEndWindowRight[probeNr])) {
                      medianRight = median(bsmHNA[chrNonHomoProbesStartWindowRight[probeNr]:chrNonHomoProbesEndWindowRight[probeNr]],
                        na.rm = T)
                    }
                    else {
